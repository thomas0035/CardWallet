# Copy this file to `.env` and fill in the values from your Supabase project:
#   Dashboard -> Project Settings -> API Keys
#
# Expo automatically inlines any variable prefixed EXPO_PUBLIC_ into the app
# bundle at build time. That means these values ship inside the APK and anyone
# can extract them — which is fine for both of the values below, but is exactly
# why the `secret` key (sb_secret_..., formerly service_role) must NEVER be put
# in this file. That key bypasses Row Level Security entirely.
#
# Security here rests on the RLS policies in supabase/schema.sql, not on
# keeping the publishable key hidden.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
